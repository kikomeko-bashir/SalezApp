# .env - Environment Variables Configuration
# This file contains sensitive configuration data
# NEVER commit this file to version control (add to .gitignore)

# Application Environment
# Set to 'development' for local development, 'production' for live server
NODE_ENV=development

# Server Port Configuration
# The port number where your server will run
# Default: 5000, but can be changed based on your needs
PORT=5000

# MongoDB Database Connection
# For Local Development (requires MongoDB installed locally):
MONGODB_URI=mongodb+srv://kikomekobashir29:Nakaye0%40%23@onlineshopping.jykqok8.mongodb.net/shopping-app?retryWrites=true&w=majority&appName=onlineShopping

# For Production/Cloud (MongoDB Atlas):
# Replace <username>, <password>, <cluster-url> with your actual values
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/shopping-app?retryWrites=true&w=majority
# Example: mongodb+srv://john:mypassword@cluster0.abc123.mongodb.net/shopping-app?retryWrites=true&w=majority

